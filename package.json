{
  "name": "tower-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "preview": "vite preview",
    "export-models": "node scripts/export-models.mjs",
    "balance": "node scripts/balance.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages && node scripts/pages-sw.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
